# Local secrets for the lab's services. Copy to app-secrets.env (git-ignored)
# to change them; start-lab.sh uses this example as-is if that file is missing.
REDIS_HOST=localhost
REDIS_PORT=6379
# The lab's own MongoDB (apps/local/mongodb.yaml). To use MongoDB Atlas
# instead, put your connection string here in app-secrets.env, e.g.
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?appName=<app-name>
MONGO_URI=mongodb://mongodb.development.svc.cluster.local:27017/microservices
