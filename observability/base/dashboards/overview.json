{
  "title": "Is everything OK?",
  "uid": "overview",
  "tags": [
    "overview",
    "microservices"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "One page to answer \"is everything OK?\": synthetic checks (can users use it), SLOs (are we within our objectives), firing alerts, and cluster health. Each section links its details: Service Level Objectives, Microservices, the runbooks.",
  "links": [
    {
      "title": "Service Level Objectives",
      "type": "link",
      "url": "/d/slo",
      "keepTime": true
    },
    {
      "title": "Microservices",
      "type": "link",
      "url": "/d/microservices",
      "keepTime": true
    },
    {
      "title": "Runbooks",
      "type": "link",
      "url": "https://github.com/kumarisback/gitops/blob/main/docs/runbooks.md",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(probe_success{job=\"synthetic\"}, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(probe_success{job=\"synthetic\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "options": [

        ],
        "current": {
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Can users use it? Synthetic checks, every 30s",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [

      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Checks",
      "description": "Each synthetic check, as a user would make it. \"service\": straight to the Service; \"ingress\": through the lab's Traefik. The red ones are firing EndpointDown (after 2 minutes).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (service, check, via) (probe_success{job=\"synthetic\", namespace=\"$namespace\"})",
          "refId": "A",
          "legendFormat": "{{service}} {{check}} ({{via}})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILING",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "no probes: see SyntheticProbesMissing"
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Check duration",
      "description": "How long each check takes, end to end. EndpointSlow fires above 1s for 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, check, via) (probe_duration_seconds{job=\"synthetic\", namespace=\"$namespace\"})",
          "refId": "A",
          "legendFormat": "{{service}} {{check}} ({{via}})"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Probes not running",
      "description": "Checks Prometheus can't run because the blackbox exporter is unreachable (SyntheticProberDown). Those endpoints are unwatched.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=\"synthetic\", namespace=\"$namespace\"} == 0) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Days until a TLS certificate expires",
      "description": "Earliest expiry among the https:// endpoints probed. TLSCertificateExpiringSoon warns under 21 days and pages under 7.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min((probe_ssl_earliest_cert_expiry{job=\"synthetic\"} - time()) / 86400)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          },
          "decimals": 0,
          "noValue": "no https endpoints probed yet"
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Are we meeting our objectives? Last 30 days (see Service Level Objectives)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [

      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Availability",
      "description": "Share of requests without a 5xx. The objective is 99.5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_error:ratio_rate30d{namespace=\"$namespace\"}",
          "refId": "A",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Availability error budget left",
      "description": "Unused share of the 0.5% of requests allowed to fail. Below 0 the objective is missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_error:ratio_rate30d{namespace=\"$namespace\"} / 0.005",
          "refId": "A",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Latency error budget left",
      "description": "Unused share of the 1% of requests allowed to take over 500ms. Below 0 the objective is missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_latency_slow:ratio_rate30d{namespace=\"$namespace\"} / 0.01",
          "refId": "A",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 10,
