{
  "title": "RDS PostgreSQL",
  "uid": "rds",
  "tags": [
    "rds",
    "database",
    "cloudwatch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "description": "Amazon RDS for PostgreSQL from CloudWatch (roadmap step 23, docs/DATABASE.md): load, the four alarmed metrics, replica lag and disk. CloudWatch has these at one-minute resolution at best; Database Insights in the RDS console goes down to the query.",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "CloudWatch"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "default",
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "dimensionKey": "DBInstanceIdentifier",
          "refId": "instance"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
        },
        "options": [

        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Database load (average active sessions)",
      "description": "DBLoad from Database Insights: sessions running or waiting. Above the instance's vCPUs (2 on db.t4g.micro), queries queue. Database Insights in the RDS console shows which SQL and which wait.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "CloudWatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "CloudWatch"
          },
          "refId": "A",
          "region": "default",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/RDS",
          "metricName": "DBLoad",
          "dimensions": {
            "DBInstanceIdentifier": [
              "$instance"
            ]
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "",
          "label": "${PROP('Dim.DBInstanceIdentifier')}",
          "id": "",
          "expression": ""
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "CloudWatch"
          },
          "refId": "B",
          "region": "default",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/RDS",
          "metricName": "DBLoadCPU",
          "dimensions": {
            "DBInstanceIdentifier": [
              "$instance"
            ]
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "",
          "label": "CPU: ${PROP('Dim.DBInstanceIdentifier')}",
          "id": "",
          "expression": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU",
      "description": "Alarm at 80% for 15 minutes (tf modules/database).",
      "datasource": {
        "type": "cloudwatch",
        "uid": "CloudWatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
