{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "microservice chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "containerPort", "openTelemetry"],
  "properties": {
    "nameOverride": { "type": "string" },
    "global": { "type": "object" },
    "common": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "minLength": 1,
          "description": "Image tag: the full commit SHA, or latest only for images built into the kind lab",
          "pattern": "^([0-9a-f]{40}|latest)$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "contextPath": { "type": "string", "pattern": "^(/[A-Za-z0-9._~-]+)*$" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automountToken": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "keda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "triggers": {
              "type": "array",
              "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string", "minLength": 1 } } }
            },
            "pollingInterval": { "type": "integer", "minimum": 1 },
            "cooldownPeriod": { "type": "integer", "minimum": 0 },
            "fallbackReplicas": { "type": ["integer", "null"], "minimum": 1 }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 },
        "maxUnavailable": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "verticalPodAutoscaler": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "mongodbUriSecret": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "accessSecret": { "type": "string", "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$" },
        "msk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bootstrapServers": { "type": "string", "pattern": "^([^ ,:]+:[0-9]+(,[^ ,:]+:[0-9]+)*)?$" }
          }
        }
      }
    },
    "openTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string" },
        "environment": { "enum": ["local", "dev", "staging", "production"] },
        "sampler": { "type": "string", "minLength": 1 }
      }
    },
    "requestLogging": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "requestBody": { "enum": ["NEVER", "ERRORS", "ALWAYS"] } }
    },
    "extraEnv": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
