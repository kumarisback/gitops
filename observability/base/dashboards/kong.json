{
  "title": "Kong gateway",
  "uid": "kong",
  "tags": [
    "kong",
    "gateway"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Kong, the API gateway behind the edge (roadmap step 16, docs/KONG.md): traffic, errors and latency per route, and the controller that configures it.",
  "templating": {
    "list": [

    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Traffic through Kong (every request after the edge)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [

      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second, by route",
      "description": "Kong names routes after their HTTPRoute: httproute.<namespace>.<name>.<rule>.<match>.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(kong_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Server errors, share of requests by route",
      "description": "Responses 500-599, from the service or from Kong itself (next panels tell which).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(kong_http_requests_total{code=~\"5..\"}[$__rate_interval])) / sum by (route) (rate(kong_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95, by route",
      "description": "Total time Kong took to answer: its own work plus the service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(kong_request_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Where the time goes, p95",
      "description": "The service (upstream) against Kong itself (plugins, routing). Kong should stay a few milliseconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kong_upstream_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "service (upstream)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kong_kong_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "Kong",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Server errors by source",
      "description": "source=\"service\": the service answered 5xx. source=\"kong\": Kong did (no healthy upstream, timeout), so the service never saw the request. source=\"exit\": a plugin ended the request.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (source) (rate(kong_http_requests_total{code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connections",
      "description": "Open client connections on the gateways, by state.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (kong_nginx_connections_total{state=~\"active|reading|writing|waiting\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests by consumer",
      "description": "Identified clients: partner-basic and partner-premium (API keys) and user-service-tokens (sign-in tokens checked at the gateway). Requests without one have no consumer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumer) (rate(kong_http_requests_total{consumer!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{consumer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Refused at the gateway",
      "description": "429: over a rate limit (sign-in attempts, a partner tier). 401: no valid token or API key. These never reached a service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, code) (rate(kong_http_requests_total{code=~\"401|429\"}[$__rate_interval]))",
          "legendFormat": "{{code}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Controller (Kubernetes resources into Kong configuration)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": [

      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Configuration pushes",
      "description": "Every change to a route or plugin becomes a new configuration pushed to each gateway. success=\"false\": Kong refused it and keeps serving the last good one (KongConfigurationPushFailing).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (success) (increase(ingress_controller_configuration_push_count[5m]))",
          "legendFormat": "success={{success}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Resources Kong rejected",
      "description": "Routes or plugins the controller could not translate, or Kong would not accept (KongResourcesRejected). The controller leaves them out and logs why.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ingress_controller_translation_broken_resource_count)",
          "legendFormat": "not translatable",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ingress_controller_configuration_push_broken_resource_count)",
          "legendFormat": "refused by Kong",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [

        ]
      }
    }
  ]
}
