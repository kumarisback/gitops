{
  "title": "Microservices",
  "tags": [
    "microservices"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info{pod=~\"(frontend|user-service|order-service)-.*\"}, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(kube_pod_info{pod=~\"(frontend|user-service|order-service)-.*\"}, namespace)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "options": [

        ],
        "current": {
        }
      },
      {
        "name": "log_type",
        "label": "Log type",
        "type": "custom",
        "query": "api,server",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [

        ]
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Pod CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"(frontend|user-service|order-service)-.*\",container!=\"POD\",container!=\"\"}[5m]))",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Pod Memory",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\",pod=~\"(frontend|user-service|order-service)-.*\",container!=\"POD\",container!=\"\"})",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "API Request Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (job, method, status) (rate(http_server_requests_seconds_count{namespace=\"$namespace\"}[5m]))",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "API 5xx Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (job, status) (rate(http_server_requests_seconds_count{namespace=\"$namespace\",status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Ready Pods",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"$namespace\",condition=\"true\",pod=~\"(frontend|user-service|order-service)-.*\"})",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "API P95 Latency",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"$namespace\"}[5m])))",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Container Restarts",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\",pod=~\"(frontend|user-service|order-service)-.*\"}[15m]))",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Collector Accepted Spans",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"otelcol_receiver_accepted_spans(_total)?\"}[5m]))",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "stat",
      "title": "Missing Backend Scrapes",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "expr": "absent_over_time(up{namespace=\"$namespace\",service=~\"order-service|user-service\"}[10m])",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "type": "logs",
      "title": "API calls",
      "description": "One line per request from each service (RequestLoggingFilter, log_type=\"api\"): method, route, status and duration, plus the request payload where the environment logs it (local/dev: every request; staging/prod: failed requests only), with secret fields masked. Response bodies are never logged. Click trace_id to open the trace.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"$namespace\", log_type=\"api\"} | json | line_format \"{{.container}}  {{.http_request_method}} {{or .http_route .url_path}} → {{.http_response_status_code}} in {{.duration_ms}}ms{{if .http_request_body}}  payload={{.http_request_body}}{{end}}  trace_id={{.trace_id}}\""
        }
      ],
      "id": 12
    },
    {
      "type": "logs",
      "title": "Edge requests (ingress access log)",
      "description": "What clients saw at the entrance, one line per request (log_type=\"edge\"): status, total time including the network hop, client address. The trace_id is the same as on the service's API line. Local lab only (Traefik); in the cloud the ALB writes these to S3 (apps/base/ingress.yaml).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"traefik\", log_type=\"edge\"} | json | KubernetesIngressNamespace=\"$namespace\" | line_format \"{{.RequestMethod}} {{.RequestPath}} → {{.DownstreamStatus}} in {{div .Duration 1000000}}ms  client={{.ClientHost}}  service={{.KubernetesServiceName}}  trace_id={{.trace_id}}\""
        }
      ],
      "id": 13
    },
    {
      "type": "logs",
      "title": "Application Logs ($log_type)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 60
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{namespace=\"$namespace\", container=~\"frontend|user-service|order-service\", log_type=~\"$log_type\"}",
          "refId": "A"
        }
      ],
      "id": 10
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Failed requests (click a dot to open the trace)",
      "description": "Server spans with an error status, from the collector's span metrics (100% of spans). Each dot is an exemplar: one failing request whose trace the tail sampler always keeps.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "exemplar": true,
          "legendFormat": "{{service_name}}",
          "expr": "sum by (service_name) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\", k8s_namespace_name=\"$namespace\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [

        ]
      }
    }
  ],
  "uid": "microservices"
}
