{
  "title": "Service Level Objectives",
  "uid": "slo",
  "tags": [
    "slo",
    "microservices"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "description": "SLOs for order-service and user-service: 99.5% of requests without 5xx and 99% within 500ms, over 30 days. The 30-day figures use as much history as Prometheus keeps.",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(slo:sli_requests:rate1h, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(slo:sli_requests:rate1h, namespace)",
        "refresh": 2,
        "options": [

        ],
        "current": {
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(slo:sli_requests:rate1h{namespace=\"$namespace\"}, job)",
          "refId": "service"
        },
        "definition": "label_values(slo:sli_requests:rate1h{namespace=\"$namespace\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [

        ],
        "current": {
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability: 99.5% of requests without a 5xx",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [

      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Availability, last 30 days",
      "description": "Share of requests that did not return 5xx. The objective is 99.5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_error:ratio_rate30d{namespace=\"$namespace\", job=~\"$service\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Availability error budget left",
      "description": "How much of the 30-day allowance of failed requests (0.5%) is unused. Below 0 the objective is missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_error:ratio_rate30d{namespace=\"$namespace\", job=~\"$service\"} / 0.005",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Availability burn rate",
      "description": "Burn rate: how fast the 30-day error budget is being spent. 1x uses it up in exactly 30 days. The page lines are 14.4x (1h window) and 6x (6h window); see observability/base/slo-rules.yaml.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate1h{namespace=\"$namespace\", job=~\"$service\"} / 0.005",
          "legendFormat": "{{job}} 1h",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate6h{namespace=\"$namespace\", job=~\"$service\"} / 0.005",
          "legendFormat": "{{job}} 6h",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Latency: 99% of requests within 500ms",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": [

      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Requests within 500ms, last 30 days",
      "description": "Share of requests that finished within 500ms. The objective is 99%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_latency_slow:ratio_rate30d{namespace=\"$namespace\", job=~\"$service\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Latency error budget left",
      "description": "How much of the 30-day allowance of slow requests (1%) is unused. Below 0 the objective is missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_latency_slow:ratio_rate30d{namespace=\"$namespace\", job=~\"$service\"} / 0.01",
          "legendFormat": "{{job}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": [

        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency burn rate",
      "description": "Burn rate: how fast the 30-day error budget is being spent. 1x uses it up in exactly 30 days. The page lines are 14.4x (1h window) and 6x (6h window); see observability/base/slo-rules.yaml.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_latency_slow:ratio_rate1h{namespace=\"$namespace\", job=~\"$service\"} / 0.01",
          "legendFormat": "{{job}} 1h",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_latency_slow:ratio_rate6h{namespace=\"$namespace\", job=~\"$service\"} / 0.01",
          "legendFormat": "{{job}} 6h",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": [

        ]
      }
    }
  ]
}
